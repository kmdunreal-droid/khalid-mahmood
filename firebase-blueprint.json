        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["stationId", "recipientUid", "severity", "eventType", "title", "message", "isRead", "createdAt"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Immutable Stock In / Stock Out ledger entry for underground tank inventory.",
      "type": "object",
      "properties": {
        "stationId": { "type": "string", "maxLength": 128 },
        "tankId": { "type": "string", "maxLength": 128 },
        "tankCode": { "type": "string", "maxLength": 16 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 100 },
        "gradeCode": { "type": "string", "maxLength": 16 },
        "direction": { "type": "string", "enum": ["IN", "OUT"] },
        "movementType": { "type": "string", "enum": ["TANKER_DECANT", "NOZZLE_SALES", "TESTING_RETURN", "EVAPORATION_LOSS", "STOCK_ADJUSTMENT"] },
        "quantityLitres": { "type": "number" },
        "balanceAfterLitres": { "type": "number" },
        "referenceNo": { "type": "string", "maxLength": 48 },
        "densityObserved": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 },
        "recordedByUid": { "type": "string", "maxLength": 128 },
        "movementDate": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["stationId", "tankId", "tankCode", "productId", "productName", "gradeCode", "direction", "movementType", "quantityLitres", "balanceAfterLitres", "referenceNo", "recordedByUid", "movementDate", "createdAt"]
    },
    "AccountingTransaction": {
      "title": "AccountingTransaction",
      "description": "Cash Book, Bank Book, Contra, and Operating Expense ledger entry per station.",
      "type": "object",
      "properties": {
        "stationId": { "type": "string", "maxLength": 128 },
        "bookType": { "type": "string", "enum": ["CASH", "BANK", "CONTRA"] },
        "entryCategory": { "type": "string", "enum": ["FUEL_SALES_RECEIPT", "CUSTOMER_PAYMENT", "SUPPLIER_PAYMENT", "OPERATING_EXPENSE", "BANK_DEPOSIT", "CASH_WITHDRAWAL", "OWNER_CAPITAL", "OTHER_INCOME"] },
        "direction": { "type": "string", "enum": ["INFLOW", "OUTFLOW"] },
        "txDate": { "type": "string", "maxLength": 16 },
        "voucherNo": { "type": "string", "maxLength": 32 },
        "accountName": { "type": "string", "maxLength": 100 },
        "partyOrVendor": { "type": "string", "maxLength": 140 },
        "expenseCategory": { "type": "string", "enum": ["GENERATOR_FUEL", "UTILITIES", "MAINTENANCE", "STAFF_WELFARE", "SALARIES", "RENT", "CLEANING", "BANK_CHARGES"] },
        "paymentMode": { "type": "string", "enum": ["CASH", "UPI", "CARD", "NEFT", "RTGS", "CHEQUE", "CONTRA"] },
        "amount": { "type": "number" },
        "referenceNo": { "type": "string", "maxLength": 48 },
        "description": { "type": "string", "maxLength": 300 },
        "approvalStatus": { "type": "string", "enum": ["APPROVED", "PENDING_OWNER"] },
        "recordedByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["stationId", "bookType", "entryCategory", "direction", "txDate", "voucherNo", "accountName", "partyOrVendor", "paymentMode", "amount", "referenceNo", "approvalStatus", "recordedByUid", "createdAt"]
    }
