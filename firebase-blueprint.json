        "txType": { "type": "string", "enum": ["INVOICE_DEBIT", "PAYMENT_CREDIT", "ADJUSTMENT"] },
        "amount": { "type": "number" },
        "runningBalance": { "type": "number" },
        "referenceId": { "type": "string", "maxLength": 128 },
