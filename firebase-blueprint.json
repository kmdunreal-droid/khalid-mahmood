{
  "entities": {
    "ConnectionCheck": {
      "title": "ConnectionCheck",
      "description": "Connectivity verification document for startup Firestore health check.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "maxLength": 32,
          "description": "Connection probe state."
        }
      },
      "required": ["status"]
    },
    "Station": {
      "title": "Station",
      "description": "Root multi-tenant petrol station document isolating forecourt operations, tanks, shifts, and ledgers.",
      "type": "object",
      "properties": {
        "stationCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[A-Z0-9-]+$",
          "description": "Unique station code (e.g., STN-HWY-04)."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Registered petrol pump station name."
        },
        "licenseNo": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "description": "Petroleum & explosives retail license number."
        },
        "taxGstNo": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "description": "GST/VAT tax identifier."
        },
        "timezone": {
          "type": "string",
          "maxLength": 48,
          "description": "IANA timezone for shift cutoffs."
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Firebase Auth UID of the primary station owner."
        },
        "isActive": {
          "type": "boolean",
          "description": "Operational status flag."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["stationCode", "name", "licenseNo", "taxGstNo", "timezone", "ownerUid", "isActive", "createdAt", "updatedAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Operational identity and RBAC role assignment document (non-PII fields).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Firebase Auth UID matching document ID."
        },
        "stationId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Assigned station ID (or ALL for multi-station Owner)."
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Display name shown in shift rosters and approvals."
        },
        "employeeCode": {
          "type": "string",
          "maxLength": 24,
          "description": "Station badge code."
        },
        "role": {
          "type": "string",
          "enum": ["OWNER", "MANAGER", "OPERATOR"],
          "description": "RBAC privilege tier."
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "SUSPENDED"],
          "description": "Account activation status."
        },
        "assignedBy": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of Owner/Manager who provisioned the role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "stationId", "displayName", "employeeCode", "role", "status", "assignedBy", "createdAt", "updatedAt"]
    },
    "UserPrivatePii": {
      "title": "UserPrivatePii",
      "description": "PII-isolated private contact details restricted strictly to the user or Owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Owning Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Verified login email."
        },
        "phone": {
          "type": "string",
          "maxLength": 24,
          "description": "E.164 phone number."
        },
        "emergencyContact": {
          "type": "string",
          "maxLength": 120,
          "description": "Emergency contact details."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "email", "phone", "updatedAt"]
    },
    "RoleAccessRequest": {
      "title": "RoleAccessRequest",
      "description": "Pending onboarding request submitted by a signed-in user awaiting Owner/Manager role approval.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Requesting user UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Requesting user verified email."
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Applicant full name."
        },
        "stationId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Target station ID."
        },
        "requestedRole": {
          "type": "string",
          "enum": ["MANAGER", "OPERATOR"],
          "description": "Requested operational role."
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "APPROVED", "DECLINED"],
          "description": "Approval status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server submission timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server decision timestamp."
        }
      },
      "required": ["uid", "email", "displayName", "stationId", "requestedRole", "status", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only immutable audit entry for security and financial events.",
      "type": "object",
      "properties": {
        "stationId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Parent station ID."
        },
        "actorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "UID of actor."
        },
        "module": {
          "type": "string",
          "maxLength": 48,
          "description": "Originating module."
        },
        "action": {
          "type": "string",
          "maxLength": 64,
          "description": "Action verb."
        },
        "entityType": {
          "type": "string",
          "maxLength": 48,
          "description": "Target collection."
        },
        "entityId": {
          "type": "string",
          "maxLength": 128,
          "description": "Target document ID."
        },
        "summary": {
          "type": "string",
          "maxLength": 500,
          "description": "Human-readable change summary."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server event timestamp."
        }
      },
      "required": ["stationId", "actorUid", "module", "action", "entityType", "entityId", "summary", "createdAt"]
    },
    "FuelProduct": {
      "title": "FuelProduct",
      "description": "Station fuel grade or lubricant catalog entry.",
      "type": "object",
      "properties": {
        "stationId": { "type": "string", "maxLength": 128 },
        "sku": { "type": "string", "maxLength": 32 },
